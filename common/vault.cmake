# The key that seals the cosmetics is not part of the source. Official builds pass it; without it the key is all
# zeroes and only unsealed cosmetics, or ones sealed with that same empty key, can be read.
set(MONCHI_COSMETICS_KEY "" CACHE STRING "64 hex digits that seal the cosmetics")

function(monchi_vault_key target)
    set(key "${MONCHI_COSMETICS_KEY}")
    if(key STREQUAL "")
        string(REPEAT "0" 64 key)
    endif()
    if(NOT key MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "MONCHI_COSMETICS_KEY must be 64 hex digits")
    endif()
    string(LENGTH "${key}" digits)
    if(NOT digits EQUAL 64)
        message(FATAL_ERROR "MONCHI_COSMETICS_KEY must be 64 hex digits")
    endif()
    set(bytes "")
    foreach(i RANGE 31)
        math(EXPR at "${i} * 2")
        string(SUBSTRING "${key}" ${at} 2 byte)
        math(EXPR sealed "0x${byte} ^ ((0x5b + ${i} * 0x1d) & 0xff)")
        string(APPEND bytes "${sealed}, ")
    endforeach()
    set(dir "${CMAKE_CURRENT_BINARY_DIR}/vault")
    file(CONFIGURE OUTPUT "${dir}/VaultKey.hpp" CONTENT "#pragma once\n\nnamespace vaultkey {\n\ninline constexpr unsigned char base = 0x5b, step = 0x1d;\ninline const unsigned char sealed[32] = {${bytes}};\n\n}\n" @ONLY)
    target_include_directories(${target} PRIVATE "${dir}")
endfunction()
