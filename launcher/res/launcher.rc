#include "resource.h"
#include <winuser.h>

IDI_APP ICON "icon.ico"
IDR_FONT_REGULAR RCDATA "../../assets/fonts/Poppins-Regular.ttf"
IDR_FONT_BOLD    RCDATA "../../assets/fonts/Poppins-Medium.ttf"
IDR_SKIN_BOY     RCDATA "skin_boy.png"
IDR_SKIN_GIRL    RCDATA "skin_girl.png"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "launcher.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Monchi Launcher"
            VALUE "ProductName", "Monchi"
            VALUE "FileVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
